# Python caches and local environments
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local datasets and generated data
data/**
!data/
!data/.gitkeep
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/images/
!data/images/.gitkeep
!data/assets/
!data/assets/.gitkeep

# Knowledge files generated from Wikidata / CLIP encoding
knowledge/**
!knowledge/
!knowledge/.gitkeep

# Training outputs, checkpoints, logs, split CSVs
outputs/
runs/
wandb/
logs/
checkpoints/
*.pt
*.pth
*.ckpt

# Local temporary files and backups
*.bak
*.tmp
*.log

# Secrets or machine-specific config
.env
.env.*
secrets.*
